# Database connection. Defaults match docker-compose.yml.
# To use Tiger Cloud / managed TimescaleDB instead, paste your connection string here.
DATABASE_URL=postgres://weather:weather@localhost:5433/weather

# Number of cities to seed (max = entries in lib/cities.ts)
SEED_CITIES=150

# Days of history + forecast horizon (days)
HISTORY_DAYS=10
FORECAST_DAYS=3

# Set to 1 to skip Open-Meteo and seed deterministic synthetic data only (offline)
# SYNTH_ONLY=1

# Protect /api/refresh when exposed publicly (cron). When set, callers must pass
# this token via "Authorization: Bearer <secret>" or "?secret=<secret>".
# CRON_SECRET=

# Interval (minutes) for the local "npm run cron" scheduler. Default 10.
# REFRESH_INTERVAL_MIN=10
